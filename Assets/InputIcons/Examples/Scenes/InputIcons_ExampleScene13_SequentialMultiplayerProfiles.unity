  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '3D text example

    To move <color=orange>use <sprite="Keyboard and Mouse_Grey"
    name="W"><sprite="Keyboard and Mouse_Grey" name="A"><sprite="Keyboard and Mouse_Grey"
    name="S"><sprite="Keyboard and Mouse_Grey" name="D"> or <sprite="Keyboard and
    Mouse_Grey" name="UPARROW"><sprite="Keyboard and Mouse_Grey" name="LEFTARROW"><sprite="Keyboard
    and Mouse_Grey" name="DOWNARROW"><sprite="Keyboard and Mouse_Grey" name="RIGHTARROW"></color>

    Press
    <color=red><sprite="Keyboard and Mouse_Grey" name="LEFTBUTTON", tint> or <sprite="Keyboard
    and Mouse_Grey" name="Z", tint> to attack</color>

    Use <sprite="Keyboard
    and Mouse_Grey" name="SPACE"> or <sprite="Keyboard and Mouse_Grey" name="U">
    or <sprite="Keyboard and Mouse_Grey" name="I"> to jump'
  m_isRightToLeft: 0
